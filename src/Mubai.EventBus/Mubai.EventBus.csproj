<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<!-- NuGet info -->
		<PackageId>Mubai.EventBus</PackageId>
		<Version>0.1.0</Version>
		<Title>Mubai.EventBus</Title>
		<Description>Production-ready Snowflake ID generator for .NET.</Description>
		<Authors>mubai-gl</Authors>
		<Company>mubai-gl</Company>
		<Copyright>© 2025 mubai-gl. All rights reserved.</Copyright>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>

		<!-- Project info -->
		<PackageProjectUrl>https://github.com/mubai-gl/Mubai.EventBus</PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>

		<!-- Repository info -->
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/mubai-gl/Mubai.EventBus.git</RepositoryUrl>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.0" />
	</ItemGroup>

</Project>
